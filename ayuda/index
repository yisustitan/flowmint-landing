<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FlowMint App — Centro de Ayuda &amp; Tutorial Oficial</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#0B0F19;
    --bg-alt:#0F172A;
    --card:#1E293B;
    --card-hover:#243248;
    --border:#334155;
    --mint:#10B981;
    --mint-light:#34D399;
    --mint-deep:#059669;
    --text:#F8FAFC;
    --text-sec:#94A3B8;
    --text-mute:#64748B;
    --radius:16px;
    --radius-sm:10px;
    --font:'Inter', system-ui, -apple-system, sans-serif;
    --font-mono:'JetBrains Mono', monospace;
  }

  *{ box-sizing:border-box; margin:0; padding:0; }
  html{ scroll-behavior:smooth; }

  body{
    font-family:var(--font);
    background:
      radial-gradient(ellipse 900px 480px at 15% -5%, rgba(16,185,129,0.10), transparent 60%),
      radial-gradient(ellipse 700px 420px at 100% 10%, rgba(52,211,153,0.06), transparent 55%),
      var(--bg);
    color:var(--text);
    line-height:1.6;
    -webkit-font-smoothing:antialiased;
  }

  a{ color:inherit; text-decoration:none; }
  ul{ list-style:none; }

  @media (prefers-reduced-motion:reduce){
    *{ animation-duration:0.001ms !important; transition-duration:0.001ms !important; }
  }

  /* ===== LANGUAGE CONTROL ===== */
  .lang-en{ display:none; }
  body.lang-english .lang-es{ display:none; }
  body.lang-english .lang-en{ display:inline; }
  body.lang-english div.lang-en,
  body.lang-english p.lang-en,
  body.lang-english li.lang-en,
  body.lang-english h1.lang-en,
  body.lang-english h2.lang-en,
  body.lang-english h3.lang-en,
  body.lang-english h4.lang-en,
  body.lang-english span.lang-en.block{ display:block; }

  .container{ max-width:1120px; margin:0 auto; padding:0 24px; }

  /* ===== NAVBAR ===== */
  nav{
    position:sticky; top:0; z-index:100;
    background:rgba(11,15,25,0.85);
    backdrop-filter:blur(14px);
    -webkit-backdrop-filter:blur(14px);
    border-bottom:1px solid var(--border);
  }
  .nav-inner{
    max-width:1120px; margin:0 auto; padding:14px 24px;
    display:flex; align-items:center; justify-content:space-between; gap:16px;
  }
  .brand{ display:flex; align-items:center; gap:11px; flex-shrink:0; }
  .brand-badge{
    width:36px; height:36px; border-radius:10px;
    background:linear-gradient(135deg, var(--mint-light) 0%, var(--mint-deep) 100%);
    display:flex; align-items:center; justify-content:center;
    font-size:18px; box-shadow:0 6px 18px -6px rgba(16,185,129,0.5);
  }
  .brand-text h1{ font-size:16.5px; font-weight:800; letter-spacing:-0.01em; }
  .brand-text span{ font-size:11px; color:var(--text-sec); }

  .nav-right{ display:flex; align-items:center; gap:10px; }

  .nav-links{
    display:flex; align-items:center; gap:4px;
    list-style:none;
  }
  .nav-links a{
    font-size:13.5px; font-weight:500; color:var(--text-sec);
    padding:8px 12px; border-radius:8px;
    transition:color .2s ease, background .2s ease;
  }
  .nav-links a:hover{ color:var(--text); background:rgba(255,255,255,0.05); }

  .lang-btn{
    background:var(--card);
    border:1px solid var(--border);
    color:var(--mint-light);
    padding:8px 15px;
    border-radius:100px;
    font-weight:600; font-size:12.5px;
    cursor:pointer;
    transition:background .2s ease, border-color .2s ease;
    white-space:nowrap;
  }
  .lang-btn:hover{ background:var(--card-hover); border-color:var(--mint); }

  .cta-btn{
    display:inline-flex; align-items:center; gap:8px;
    background:linear-gradient(135deg, var(--mint-light), var(--mint-deep));
    color:#052e21;
    font-weight:700; font-size:13.5px;
    padding:10px 18px; border-radius:10px;
    box-shadow:0 8px 20px -8px rgba(16,185,129,0.55);
    transition:transform .2s ease, box-shadow .2s ease;
    white-space:nowrap;
  }
  .cta-btn:hover{ transform:translateY(-2px); box-shadow:0 12px 26px -8px rgba(16,185,129,0.65); }

  .menu-toggle{
    display:none;
    background:none; border:1px solid var(--border); border-radius:8px;
    width:38px; height:38px; color:var(--text);
    align-items:center; justify-content:center; cursor:pointer;
    flex-shrink:0;
  }
  .menu-toggle svg{ width:18px; height:18px; }

  /* ===== HERO ===== */
  .hero{ text-align:center; padding:76px 24px 40px; }
  .hero-eyebrow{
    display:inline-flex; align-items:center; gap:8px;
    font-size:12.5px; font-weight:600; color:var(--mint-light);
    background:rgba(16,185,129,0.1); border:1px solid rgba(16,185,129,0.28);
    padding:6px 14px; border-radius:100px; margin-bottom:22px;
  }
  .hero h2{
    font-size:clamp(1.9rem, 4.6vw, 3rem);
    font-weight:800; letter-spacing:-0.025em;
    max-width:760px; margin:0 auto;
  }
  .hero p{
    margin-top:16px; font-size:16.5px; color:var(--text-sec);
    max-width:580px; margin-left:auto; margin-right:auto;
  }

  /* ===== SECTION SHELL ===== */
  section.block{ padding:16px 24px 64px; }
  .section-head{ margin-bottom:26px; }
  .section-head h3{ font-size:22px; font-weight:800; letter-spacing:-0.01em; margin-bottom:8px; }
  .section-head p{ color:var(--text-sec); font-size:14.5px; max-width:620px; }

  /* ===== VIDEO CARD ===== */
  .card{
    background:var(--card); border:1px solid var(--border);
    border-radius:var(--radius); padding:24px;
  }
  .video-box{
    position:relative; width:100%; aspect-ratio:16/9;
    background:#000; border-radius:12px; overflow:hidden;
    border:1px solid var(--border); margin-bottom:22px;
    display:flex; align-items:center; justify-content:center;
  }
  .video-box iframe{ position:absolute; inset:0; width:100%; height:100%; border:0; }

  .video-info h4{ font-size:18px; font-weight:700; margin-bottom:8px; }
  .video-info > p.desc{ color:var(--text-sec); font-size:14px; margin-bottom:20px; max-width:680px; }

  .timestamp-list{ display:flex; flex-direction:column; gap:2px; }
  .timestamp-item{
    display:flex; align-items:center; gap:12px;
    padding:9px 4px; border-bottom:1px solid rgba(255,255,255,0.05);
    font-size:13.5px;
  }
  .timestamp-item:last-child{ border-bottom:0; }
  .timestamp-item .time{
    font-family:var(--font-mono); font-size:12px; font-weight:600;
    color:var(--mint-light); background:rgba(16,185,129,0.1);
    padding:3px 8px; border-radius:6px; flex-shrink:0; min-width:52px; text-align:center;
  }
  .timestamp-item .label{ color:var(--text-sec); }

  /* ===== QUICK ACCESS ===== */
  .quick-grid{
    display:grid; grid-template-columns:repeat(auto-fit, minmax(260px, 1fr));
    gap:18px;
  }
  .quick-card{
    background:var(--card); border:1px solid var(--border);
    border-radius:var(--radius); padding:24px;
    display:flex; flex-direction:column; gap:12px;
    transition:transform .2s ease, border-color .2s ease;
  }
  .quick-card:hover{ transform:translateY(-3px); border-color:var(--mint); }
  .quick-icon{
    width:42px; height:42px; border-radius:11px;
    background:rgba(16,185,129,0.12); color:var(--mint-light);
    display:flex; align-items:center; justify-content:center;
  }
  .quick-icon svg{ width:21px; height:21px; }
  .quick-card h4{ font-size:16.5px; font-weight:700; }
  .quick-card p{ color:var(--text-sec); font-size:13.5px; flex-grow:1; }
  .quick-card .cta-btn{ align-self:flex-start; margin-top:4px; }
  .quick-card .steps{ display:flex; flex-direction:column; gap:6px; margin-top:4px; }
  .quick-card .steps li{ font-size:13px; color:var(--text-sec); padding-left:18px; position:relative; }
  .quick-card .steps li::before{
    content:'0' counter(step-counter); counter-increment:step-counter;
    position:absolute; left:0; top:0;
    font-family:var(--font-mono); font-size:11px; color:var(--mint-light); font-weight:700;
  }
  .quick-card .steps{ counter-reset:step-counter; }

  /* ===== FAQ ===== */
  .faq-item{
    background:var(--card); border:1px solid var(--border);
    border-radius:var(--radius-sm); margin-bottom:12px; overflow:hidden;
  }
  .faq-item summary{
    list-style:none; cursor:pointer; font-weight:600; font-size:14.5px;
    padding:18px 20px; display:flex; align-items:center; justify-content:space-between; gap:16px;
    outline:none;
  }
  .faq-item summary::-webkit-details-marker{ display:none; }
  .faq-icon{
    width:24px; height:24px; border-radius:50%; flex-shrink:0;
    background:rgba(16,185,129,0.12); color:var(--mint-light);
    display:flex; align-items:center; justify-content:center;
    transition:transform .25s ease, background .2s ease;
  }
  .faq-icon svg{ width:13px; height:13px; }
  .faq-item[open] .faq-icon{ transform:rotate(45deg); background:var(--mint); color:#052e21; }
  .faq-item p{ padding:0 20px 20px; color:var(--text-sec); font-size:13.5px; max-width:680px; }

  /* ===== SUPPORT ===== */
  .support-card{
    background:linear-gradient(150deg, var(--card) 0%, #142a22 140%);
    border:1px solid rgba(16,185,129,0.3);
    border-radius:var(--radius); padding:40px;
    text-align:center;
  }
  .support-status{
    display:inline-flex; align-items:center; gap:8px;
    font-family:var(--font-mono); font-size:12px; color:var(--mint-light);
    background:rgba(16,185,129,0.1); border:1px solid rgba(16,185,129,0.28);
    padding:6px 14px; border-radius:100px; margin-bottom:20px;
  }
  .support-status::before{
    content:''; width:7px; height:7px; border-radius:50%;
    background:var(--mint-light); box-shadow:0 0 8px var(--mint-light);
    animation:pulse 2s ease-in-out infinite;
  }
  @keyframes pulse{ 0%,100%{opacity:1;} 50%{opacity:0.3;} }
  .support-card h3{ font-size:22px; font-weight:800; margin-bottom:10px; }
  .support-card p{ color:var(--text-sec); font-size:14.5px; max-width:520px; margin:0 auto; }

  /* ===== FOOTER ===== */
  footer{
    border-top:1px solid var(--border);
    padding:34px 24px; text-align:center;
  }
  footer p{ color:var(--text-mute); font-size:13px; margin-bottom:10px; }
  .footer-links{ display:flex; justify-content:center; gap:20px; flex-wrap:wrap; }
  .footer-links a{ font-size:13px; color:var(--text-sec); transition:color .2s ease; }
  .footer-links a:hover{ color:var(--mint-light); }

  /* ===== RESPONSIVE / MOBILE-FIRST ===== */
  @media (max-width:860px){
    .nav-links{
      display:none;
      position:absolute; top:100%; left:0; right:0;
      background:var(--bg-alt); border-bottom:1px solid var(--border);
      flex-direction:column; align-items:stretch;
      padding:10px 16px 16px;
      gap:2px;
    }
    .nav-links.open{ display:flex; }
    .nav-links a{ padding:12px 10px; border-radius:8px; }
    .menu-toggle{ display:flex; }
    nav{ position:sticky; }
    .nav-inner{ position:relative; }
  }

  @media (max-width:640px){
    .hero{ padding:52px 20px 32px; }
    section.block{ padding:10px 20px 48px; }
    .card{ padding:18px; }
    .support-card{ padding:28px 22px; }
    .cta-btn span.cta-long{ display:none; }
  }

  a:focus-visible, summary:focus-visible, button:focus-visible{
    outline:2px solid var(--mint);
    outline-offset:2px;
  }
</style>
</head>
